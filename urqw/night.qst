	_ доп_описание = доп_описание + "Купить шпинат для тетушки Альберты... Зайти к дяде Джозефу насчет водопровода... "
if блокнот_стр=2 then доп_описание = "На следующих страницах написана куча телефонных номеров. Вряд ли они тебе пригодятся. "
if блокнот_стр=3 then 
	_ доп_описание = "Несколько листов  неаккуратно вырвано. На оставшихся обрывках ты видишь несколько чисел: 3516, 2832, 711.. (дальше оторвано) " &
	_ if блокнот_прочитан=0 then блокнот_прочитан=1
if блокнот_стр=4 then 
	_ доп_описание = "На последней странице имеется запись: Крестный обещал пришить меня, если я снова забуду код. Я записал его в блокнот, но боюсь, что потеряю. Пусть, если что, мне напомнит покойный Джим Райли. " &
	_ if блокнот_прочитан < 2 then блокнот_прочитан = 2

действия = "[[листать блокнот|блокнот_листать]]"
