доп_описание = "Вход в склеп свободен, можно спуститься. "
действия = "[[спуститься в склеп|склеп]]"
proc шаблон
end

:склеп_снаружи
доп_описание = "Склеп твоей тети, построенный ей для себя еще при жизни, облицован белоснежным мрамором и украшен колоннами и резьбой по камню. Стоил он ей, очевидно, целое состояние. Ты не видишь в стенх ни окон, ни вентиляционных отдушин, через которые можно было бы забраться внутрь. "
действия = ""
proc шаблон
end

:двери
доп_описание = "Двери склепа украшены чугунным литьем. Они наглухо закрыты и в них нет ни замка, ни замочной скважины. "
if count_усклепа=1 then
	_ доп_описание = доп_описание + "Ты немного растерян и не знаешь, что делать дальше. За все время пути сюда ты ни разу не задумался о том, как попадешь внутрь склепа. Очевидно, что сделать это будет не очень просто, учитывая, какое сокровище хранится внутри. (И нет, речь сейчас не про останки твоей драгоценной тетушки.) "
действия = "[[открыть двери|двери_открыть]]"
if Лом then
	_ proc сделать & действия = действия + "[[взломать двери|двери_взломать]]"
if Взрывчатка then
	_ proc сделать & действия = действия + "[[взорвать двери|двери_взорвать]]"
proc шаблон
end

