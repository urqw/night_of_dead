	_ иллюстрация = "scull1.jpg"
if заражение=10 then
	_ описание = "Ты чувствуешь сильное головокружение. Тело охватывает сильный жар, раны горят огнем. " &
	_ иллюстрация = "scull2.jpg"
if заражение=15 then
	_ описание = "Твое тело внезапно сотрясают сильные судороги. Нестерпимо болит голова. Тело бросает то в жар, то в холод. Тебе приходится опуститься на землю, чтобы немного прийти в себя. " &
	_ иллюстрация = "scull3.jpg"
if заражение=20 then
	_ описание = "У тебя темнеет в глазах и ты бессильно падаешь на землю. Чувствуя нестерпимое жжение в груди, ты раздираешь ее ногтями, словно пытаясь добраться до источника боли. Мир погружается во тьму... " &
	_ иллюстрация = "scull4.jpg"
доп_описание = ""
выходы = ""
if заражение=20 then
	_ описание = описание + "[[дальше...|смерть]]"
_ else
	_ описание = описание + "[[дальше...|#%ЛОК$]]"
действия = ""
proc шаблон
:неболезнь
end

