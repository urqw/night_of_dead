;------------------------------------------------------------------------------
; заставка при победе

:победа
invkill
cls
if dontshowpics=0 then image="content/final.jpg"
pln
pln Ты оставил позади автобусную остановку и двинулся пешком по направлению к городу. Твои дела, кажется, начали налаживаться. Продав добытую драгоценность, ты сможешь расплатиться с долгами и начать новую жизнь. Ты улыбнулся и прибавил шаг. Погрузившись в мечты, ты не заметил бледную худую фигуру, облаченную в истлевшее женское платье, которая появилась в воротах кладбища и неестественной шатающейся походкой двинулась за тобой... 
pln
pln <center>КОНЕЦ</center>
pln <center>Спасибо за игру!</center>
pln <center>Ваши замечания и сообщения об ошибках просьба отправлять автору на электронную почту necrabbit@mail.ru</center>
pln
pln <center>NecRabbit, 2024 - 2026</center>
end



;------------------------------------------------------------------------------
; рандомные события

:случай
место="снаружи"
if ЛОК="дом" or ЛОК="сторожка" or ЛОК="склеп" or ЛОК="колокольня" or ЛОК="церковь" or ЛОК="притвор" or ЛОК="ризница" or ЛОК="подвал" or ЛОК="подвал_темный" or ЛОК="сарай" or ЛОК="сарай_темный" then место="внутри"
if ЛОК="болото" or ЛОК="лодка" then место="вода"

случайный_номер=0
if rnd100>=90 then случайный_номер = rnd10

текст=""
if случайный_номер = 1 and место="внутри" then текст = "Внезапно ты ощущаешь спиной чей-то взгляд. Ты осторожно оборачиваешься, но, к счастью, позади никого нет. Похоже, просто нервы шалят... "
if случайный_номер = 2 and место="внутри" then текст = "Вдруг ты слышишь тихий шепот, зовущий тебя по имени. Ты оглядываешься по сторонам, но никого не видишь. "
if случайный_номер = 3 and место="внутри" then текст = "Легкий холодок сквозняка, словно чье-то тихое дыхание, пробегает по твоей шее. "
if случайный_номер = 4 and место="внутри" then текст = "Ты слышишь тихое поскрипывание. "
if случайный_номер = 5 and место="внутри" then текст = "Ты слышишь легкие, почти бесшумные шаги. "
if случайный_номер = 6 and место="внутри" then текст = "Внезапно ты ощущаешь затылком чей-то пристальный взгляд. Ты оборачиваешься, но за спиной никого. Наверное, показалось... "
if случайный_номер = 7 and место="внутри" then текст = "Вдруг ты слышишь тихий шепот, зовущий тебя по имени. Ты оглядываешься по сторонам, но вокруг никого нет. "
if случайный_номер = 8 and место="внутри" then текст = "Легкий холодок сквозняка, словно чье-то тихое дыхание, пробегает по твоей шее. "
if случайный_номер = 9 and место="внутри" then текст = "Ты слышишь тихий скрип. "
if случайный_номер = 10 and место="внутри" then текст = "Ты слышишь легкие, почти бесшумные шаги. "

if случайный_номер = 1 and место="снаружи" then текст = "Внезапно ты ощущаешь затылком чей-то пристальный взгляд. Ты резко оборачиваешься, но за спиной никого. Наверное, показалось... "
if случайный_номер = 2 and место="снаружи" then текст = "Вдруг ты слышишь тихий шепот, зовущий тебя по имени. Ты оглядываешься по сторонам, но вокруг никого нет. "
if случайный_номер = 3 and место="снаружи" then текст = "Легкий холодок сквозняка, словно чье-то тихое дыхание, пробегает по твоей шее. "
if случайный_номер = 4 and место="снаружи" then текст = "Откуда-то доносится уханье совы. "
if случайный_номер = 5 and место="снаружи" then текст = "Откуда-то издалека доносится протяжный вой. "
if случайный_номер = 6 and место="снаружи" then текст = "Издалека доносится сдавленный крик. Ты не уверен, был ли это голос человека или зверя. "
if случайный_номер = 7 and место="снаружи" then текст = "Над твоей головой с громким криком пролетает какая-то птица. "
if случайный_номер = 8 and место="снаружи" then текст = "Стоящее рядом дерево внезапно громко скрипит. "
if случайный_номер = 9 and место="снаружи" then текст = "С громким вскриком какая-то птица взлетает из-под твоих ног, заставляя подпрыгнуть от неожиданности. "
if случайный_номер = 10 and место="снаружи" then текст = "Порыв холодного ветра заставляет тебя поежиться. "

if случайный_номер < 5 and место="вода" then текст = "Неподалеку раздается громкий всплеск воды. "
if случайный_номер >= 5 and случайный_номер <= 7 and место="вода" then текст = "Откуда-то доносится протяжный стон. "
if случайный_номер > 7 and место="вода" then текст = "Ты слышишь вдалеке плеск воды. "

if случайный_номер = 0 then текст=""

if текст <> "" then
	_ доп_описание = текст
end


;------------------------------------------------------------------------------
; генерация кода сейфа

:генератор
code = rnd8888 + 1111
if code=3516 or code=2832 or code=7110 or code=3811 or code=6198 or code=1922 or code=7514 then goto генератор
end

;------------------------------------------------------------------------------
; процедура tick

:tick
turn=turn+1
if заразился = 1 then заражение = заражение + 1
if заражение = 5 then goto болезнь
if заражение = 10 then goto болезнь
if заражение = 15 then goto болезнь
if заражение = 20 then goto болезнь
end

