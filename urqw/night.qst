; локация - берег

:берег
ЛОК="берег"
proc tick
if лодка_отвязана=0 then
	_ лдк = "к которому привязана [[лодка|лодка_осм]]"
_ else
	_ лдк = "у которого покачивается [[лодка|лодка_осм]]"
название = "На берегу, у кладбища"
описание=""
if умер_флаг=1 then
	_ умер_флаг=0 &
	_ описание = "Ты приходишь в себя, лежа по пояс в воде среди зарослей осоки. Тебя мутит, голова нещадно болит и кружится, во рту странный металлический привкус. Ты с трудом вспоминаешь, что произошло. Оглядевшись, ты обнаруживаешь себя на знакомом берегу. Твоя одежда лежит неподалеку. Ты быстро одеваешься... #/$     "
if count_берег=1 then
	_ описание = "Протиснувшись через колючие кусты, ты вышел на низкий речной берег, заросший осокой и камышом. "
_ else
	_ описание = описание + "Низкий речной берег зарос осокой и камышом. "
описание = описание + "Узкая тропинка ведет к небольшому пирсу, #%лдк$. Неподалеку от пирса расположился покосившийся [[эллинг|эллинг_осм]] - лодочный сарай. С [[реки|река]] дует холодный ветер. На противоположном берегу в свете луны серебрится сплошная стена леса. У ее подножия у самой воды ты замечаешь одинокий [[огонек]]. То ли костер, то ли забытый кем-то фонарь."
доп_описание = ""
выходы = "[[на кладбище|север]]"
if Фонарик and фонарик_батарейки=1 then
	_ выходы = выходы + ", [[в эллинг|сарай]]"
_ else
	_ выходы = выходы + ", [[в эллинг|сарай_темный]]"
if count_остров=0 then
	_ выходы = выходы + ", [[сесть в лодку|лодка]]"
_ else
	_ выходы = выходы + ", [[переправиться на другой берег|остров]]"
действия = ""
иллюстрация = "river.jpg"
proc случай
proc шаблон
end

