; локация - болото

:болото
ЛОК="болото"
proc tick
название = "Болото"
описание = ""
if count_болото=1 then 
	_ описание = "Ты очнулся, лежащим наполовину в воде на куче грязи и травы. Все тело страшно болит. Бегло осмотрев себя, ты обнаружил множество кровоточащих порезов и укусов. #/$     " &
	_ if Крестик and крестик_надет = 1 then
		_ описание = описание + " Сильнее всего болит шея. Потянувшись к ней, ты нащупал недавно надетый крестик. Тебе пришло в голову, что, возможно, это он не дал монстру довершить начатое. Но ты решил подумать об этом потом, а сейчас нужно выбираться отсюда... #/$     "
if плутал>0 then 
	_ описание = "Осторожно ощупывая перед собой почву и выбирая неглубокие места для каждого шага, ты медленно движешься вперед. Однако пейзаж вокруг практически не меняется... #/$     "
if плутал=4 or плутал=7 then 
	_ описание = "Ты уже давно движешься по болоту, но пейзаж вокруг практически не меняется. Кажется, что ты ходишь кругами. Подкатывает паника и отчаяние. Нужно взять себя в руки и подумать, что делать дальше. Может быть, нужно идти в другую сторону" &
	_ if ориентация<2 then
		_ описание = описание + " или получше сориентироваться?  #/$     "
	_ else 
		_ описание = описание + "? #/$     "
описание = описание + "Вокруг тебя расстилается мрачное болото. Повсюду, куда хватает взгляда, видны лишь стволы мертвых [[деревьев|деревья]], стоящих в мутной вонючей воде и распростерших куцые ветви в разные стороны, словно в беззвучном крике о помощи. Куда идти, чтобы выбраться отсюда, совершенно [[не понятно|ориентация]]. "
доп_описание = ""
выходы = ""
if Палка and ориентация=2 then
	_ выходы = "[[идти на север|заблудился]], [[идти на юг|болото_выход]], [[идти на запад|заблудился]], [[идти на восток|заблудился]]"
if Палка and ориентация<2 then
	_ выходы = "[[идти куда-нибудь|заблудился]], [[идти не знаю куда|заблудился]], [[идти в другую сторону|заблудился]]"
if not Палка and ориентация=2 then
	_ выходы = "[[идти на север|нет_палки]], [[идти на юг|нет_палки]], [[идти на запад|нет_палки]], [[идти на восток|нет_палки]]"
if not Палка and ориентация<2 then
	_ выходы = "[[идти куда-нибудь|нет_палки]], [[идти не знаю куда|нет_палки]], [[идти в другую сторону|нет_палки]]"

действия = ""
if z=1 then иллюстрация = "swamp.jpg"
if z=2 then иллюстрация = "swamp2.jpg"
if z=3 then иллюстрация = "swamp3.jpg"
if z=4 then иллюстрация = "swamp4.jpg"

proc случай
proc шаблон
end

:заблудился
плутал = плутал + 1
z = rnd4
goto болото
end

:нет_палки
proc tick
название = "[[Болото|нет_палки]]"
описание = "Некоторое время ты идешь, стараясь держаться относительно твердой земли вблизи стволов деревьев. Но вскоре перед тобой открывается широкое, полностью покрытое водой пространство без единого дерева. Под ногами, по колено погруженными в мутную жижу, ты чувствуешь вязкую, ненадежную почву. Ты идешь вперед, осторожно ощупывая ногой место для следующего шага, но в какой-то момент не удерживаешь равновесие и наступаешь на зыбкий ил, который немедленно проваливается под твоим весом и ты по пояс уходишь в воду. Провозившись несколько минут и с ног до головы вымазавшись вонючей болотной грязью, ты выбираешься обратно на надежную почву. Пожалуй, дальше так идти опасно. "
нет_палки=1
доп_описание = ""
выходы = ""
действия = "[[продолжать идти|утонул]], [[вернуться назад|болото]]"
proc шаблон
end

:болото_выход
название = "Болото"
описание = "Осторожно ощупывая палкой дно перед собой, ты медленно движешься вперед. Постепенно на смену сплошному мертвому лесу приходят живые деревья, а зловонная топь сменяется влажным мшистым грунтом. Спустя недолгое время ты выходишь на знакомую лесную тропку, ведущую к берегу. [[дальше...|остров]]"
доп_описание = ""
выходы = ""
действия = ""
иллюстрация = "forest.jpg"
proc шаблон
end

:ориентация
доп_описание = ""
if ориентация = 2 then
	_ доп_описание = "Ты пытаешься вспомнить, как расположены кладбище и река относительно сторон света, и куда тебе следует идти. "
if деревья_осмотрены=0 then
	_ доп_описание = "Ты пытаешься успокоиться и вспомнить, что ты знаешь об ориентировании на местности. Кажется, на деревьях с северной стороны растет мох... А еще ветки на южной стороне длиннее, чем на северной." &
	_ ориентация=1
if деревья_осмотрены=1 and ориентация < 2 then
