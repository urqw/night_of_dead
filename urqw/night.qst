;------------------------------------------------------------------------------
; локация - у склепа

:усклепа
ЛОК="усклепа"
proc tick
название = "Кладбище, у склепов"
описание=""
if умер_флаг=1 then
	_ умер_флаг=0 &
	_ описание = "Ты приходишь в себя, лежа на холодной могильной плите. Тебя мутит, разбитая голова нещадно болит и кружится, во рту странный металлический привкус. Ты с трудом вспоминаешь, что произошло... #/$     "
if count_усклепа=1 then
	_ описание = "В западной части кладбища среди древних вязов, переплетающих свои узловатые ветви высоко над головой, расположено несколько богато украшенных мраморных склепов. "
_ else
	_ описание = описание + "Ты снова в западной части кладбища, где среди древних вязов, переплетающих свои узловатые ветви высоко над головой, расположено несколько богато украшенных мраморных склепов. "
описание = описание + "[[Один|склеп_снаружи]] из них принадлежит твоей [[тетушке|тетка]] - над входом изображен ее герб. "
if склеп_открыт=0 then
	_ описание = описание + "Внутрь склепа ведут тяжелые чугунные [[двери]]. "
_ else
	_ описание = описание + "Его тяжелые чугунные двери частично сорваны с петель и криво висят в проеме, открывая [[темный проход|спуск]] вниз в темноту. "
описание = описание + "Узкая песчаная дорожка ведет на запад и восток. "
if зомби=2 then
	_ описание = описание + "На дорожке лежит тело [[мертвеца|зомби_труп]]. "
if зомби=1 and not Нож then
	_ описание = описание + "На дорожке ты замечаешь [[нож]]. "

доп_описание = ""
if зомби=0 then
	_ выходы = "[[на запад|зомби]], [[на восток|север]]"
_ else
	_ выходы = "[[на запад|запад]], [[на восток|север]]"
if склеп_открыт=1 then
	_ выходы = выходы + ", [[в склеп|склеп]]"
действия = ""
иллюстрация = "crypt_out.jpg"
proc случай
proc шаблон
end

