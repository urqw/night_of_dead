	_ proc подвал &
	_ доп_описание = "Ты взял лопату. " 

действия = ""
proc шаблон
end

:ящики
доп_описание = "Ящики заполнены всякой всячиной. Ты видишь тут несколько бутылей с химикатами, несколько мешков с удобрениями, какие-то запчасти и прочий хлам. "
if not Серная кислота and Инструкция and взрывчатка_сделана=0 then
	_ доп_описание = доп_описание + "Ты находишь бутыль с [[серной кислотой|серная_кислота]]. " 
действия = ""
proc шаблон
end

:серная_кислота
доп_описание = "Небольшая стеклянная бутыль с серной кислотой. Насколько ты помнишь, она очень едкая. Нужно соблюдать осторожность. "
действия = ""
if not Серная кислота then	
	_ proc сделать & действия = действия + "[[взять кислоту|серная_кислота_взять]]"
if Серная кислота and инструкция_прочитана=1 and Бутылка then
	_ proc сделать & действия = действия + "[[налить кислоту в бутылку|серная_кислота_налить]]"
proc шаблон
end

:серная_кислота_взять
доп_описание = "Ты взял бутыль с кислотой. "
действия = ""
inv+ Серная кислота
proc шаблон
end

:серная_кислота_налить
if бутылка_содержимое=1 then
	_ доп_описание = "Сначала нужно опустошить бутылку. "
_ else if бутылка_серная=1 then
	_ доп_описание = "В бутылке уже есть серная кислота. "
_ else
	_ доп_описание = "Ты осторожно налил в бутылку немного серной кислоты. " &
	_ бутылка_серная=1 &
	_ бутылка_содержимое=2 

if бутылка_азотная=1 and бутылка_серная=1 and бутылка_глицерин=1 then
	_ доп_описание = доп_описание + "Смесь слегка задымилась и забурлила, но через минуту это прекратилось. Кажется, получилось... " &
	_ inv- Бутылка &
	_ inv- Серная кислота &
	_ inv- Азотная кислота &
	_ inv- Глицерин &	
	_ inv+ Взрывчатка &
	_ взрывчатка_сделана=1

действия = ""
proc шаблон
end

:взрывчатка
доп_описание = "Взрывчатое вещество в пластиковой бутылке. Взрывается от малейшего удара. Нужно быть осторожным! "
действия = ""
proc шаблон
