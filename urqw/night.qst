:могилы_запад
доп_описание = ""
if not Фонарик or фонарик_батарейки=0 then надгробия_запад=0
if надгробия_запад=0 and Фонарик and фонарик_батарейки=1 then
	_ доп_описание = "Во мраке этого заросшего уголка кладбища могильные плиты почти не видны. Ты освещаешь тусклым светом фонарика полустертые надписи эпитафий. "
if надгробия_запад=0 and ( not Фонарик or фонарик_батарейки=0 ) then
	_ доп_описание = "Во мраке этого заросшего уголка кладбища могильные плиты почти не видны. Ты всматриваешься в темные камни, но не можешь ничего разглядеть. "
if надгробия_запад=1 then 
	_ доп_описание = доп_описание + "Ты читаешь надписи на мраморных плитах: ~ Николас Паркс. Он бы проклял нас за то, что мы похоронили его не у пивной. ~ "
if надгробия_запад=2 then 
	_ доп_описание = доп_описание + "Ты читаешь надписи на мраморных плитах: ~ Джозеф Цепеш. Я скоро вернусь и вы все пожалеете! ~ "&
	_ if not Чеснок then
		_ доп_описание = доп_описание + "#/$     На надгробии ты находишь связку [[чеснока|чеснок]]. Кажется, кто-то серьезно опасался его возвращения из могилы. "
if надгробия_запад=3 then 
	_ доп_описание = доп_описание + "Ты читаешь надписи на мраморных плитах: ~ Джонни (Малыш) Джонсон. Ты был хорошим взломщиком. ~ #/$     Могила выглядит свежей, хотя, судя по датам на памятнике, ей не один десяток лет. Странно. "

действия = ""
if надгробия_запад=0 and Фонарик and фонарик_батарейки=1 then
	_ proc сделать & действия = действия + "[[читать эпитафии|могилы_запад_осм]]"
if надгробия_запад>0 and Фонарик and фонарик_батарейки=1 then
	_ proc сделать & действия = действия + "[[перейти к другой могиле|могилы_запад_др]]" &
	_ if Лопата then
		_ proc сделать & действия = действия + "[[раскопать эту могилу|могилы_запад_копать]]"

proc шаблон
end

:могилы_запад_др
надгробия_запад = надгробия_запад + 1
if могила_джонни_раскопана=0 then
	_ if надгробия_запад > 3 then надгробия_запад = 1
if могила_джонни_раскопана=1 then
	_ if надгробия_запад > 2 then надгробия_запад = 1
proc могилы_запад
end

:могилы_запад_осм
надгробия_запад = 1
goto могилы_запад
end

:могилы_запад_копать
if надгробия_запад=1 then
	_ доп_описание = "Тебе не хочется беспокоить Николаса, тем более, что ты не захватил с собой пива. "
if надгробия_запад=2 then
	_ if Чеснок then
		_ доп_описание = "Даже имея защиту в виде чеснока, тебе не хочется встречаться с Джозефом. "
	_ else
		_ доп_описание = "Тебе не очень хочется встречаться с Джозефом. "
if надгробия_запад=3 then
	_ if Записка or записка_прочитана=1 then
		_ могила_джонни_раскопана=1 &
		_ надгробия_запад=1 &
		_ proc запад &	
		_ доп_описание = "Памятуя написанное в записке, найденной в церкви, ты решаешь обыскать могилу Малыша Джонни. Ты начинаешь копать рыхлую землю и почти сразу лопата ударяется обо что-то твердое. Спустя пару минут ты выкапываешь небольшой фанерный ящик. Подняв крышку, ты обнаруживаешь лежащую внутри [[отмычку|отмычка]]. " 
	_ else
		_ доп_описание = "Могила, конечно, странная, но это еще не повод раскапывать ее. "
действия = ""
proc шаблон
end

