:лимб
if умер > 0 then goto смерть
название = ""
описание = "Ты будто оказался в каком-то дурном сне. Тебя кто-то преследовал, а ты от него бежал по темным затхлым коридорам и полуобвалившимся лестничным пролетам. Потом преследовал уже ты, но не кого-то, а что-то. Что-то очень нужное и важное, но постоянно ускользающее за поворотом. И не мог догнать. Реальность перед глазами то плыла клочьями серого тумана, то обострялась до предела резкости, то расползалась сверкающими кругами, какие бывают, когда трешь глаза через закрытые веки. Ты не помнишь, сколько это все продолжалось, но окончилось оно внезапно, словно резко включили свет. "
умер=1
умер_флаг=1
if Крестик then
	_ inv- Крестик &
	_ крестик_надет=0
доп_описание = ""
выходы = ""
if лимб_номер = 1 then описание = описание + "[[дальше...|усклепа]]"
if лимб_номер = 2 then описание = описание + "[[дальше...|юг]]"
