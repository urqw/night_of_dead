;------------------------------------------------------------------------------
; вывод текста локации по шаблону

:шаблон
cls
if иллюстрация <> "" and dontshowpics=0 then image="/content/#%иллюстрация$"
if название <> "" then pln <center><h3>#%название$</h3></center> 
if описание <> "" then pln #%описание$
if доп_описание <> "" then pln & pln #%доп_описание$  
if действия <> "" then pln Действия: #%действия$
if выходы <> "" then pln & pln Идти: #%выходы$
end

;------------------------------------------------------------------------------
; добавление декоративного разделителя

:сделать
if действия <> "" then действия = действия + ", "
end

