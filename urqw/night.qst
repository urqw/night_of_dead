:старт
invkill
perkill
proc переменные
proc генератор

style_backcolor = "#000"
style_textcolor = "#CCC"

dontshowpics = 0

инфо = ""
название = ""
описание = ""
доп_описание = ""
выходы = ""
действия = ""
иллюстрация = ""

goto предисловие
end

;------------------------------------------------------------------------------
; интро

:предисловие
cls
pln      ...Закончилось все тем, что ты жестко проигрался! Спустил на автоматах и рулетке все до последнего цента! Продал машину. Заложил дом. И вот, когда на пороге уже замаячили приставы с предписанием о выселении, только тогда ты пришел в себя. Но было поздно. Вариантов у тебя, прямо скажем, оставалось не много: идти ночевать под Бруклинский мост или ограбить банк... 
pln      Впрочем, был еще третий вариант. Выход. Спасение. Рубиновое колье твоей тетушки, погребенное вместе с ней в фамильном склепе на старом кладбище где-то в захолустье Луизианы. Дурацкая последняя воля усопшей, которую не решились нарушить ее многочисленные родственнички. Но теперь она может тебя спасти! Ты никогда не мечтал стать грабителем могил, но выбора нет... Не медля ни минуты, ты отправился на то самое кладбище.
pln      Так началась... [[дальше...|заставка]]
end

:заставка
cls
image="content/title.png|Обложка с изображением торчащей из могилы руки"
pln <center><h1>Ночь мертвецов</h1></center>
pln
pln <center>Автор: NecRabbit, necrabbit@mail.ru</center>
pln <center>Адаптация под платформу UrqW. Версия 1.1, 13.03.2026</center>
pln
pln <center>[[Начать игру с иллюстрациями|дорога]]</center>
pln
pln <center>[[Начать игру без иллюстраций|dontshowpics = 1 & goto дорога]]</center>
end


;------------------------------------------------------------------------------
; локация - у кладбища

:дорога
ЛОК="дорога"
proc tick
название = "У ворот кладбища"
описание = ""
if count_дорога = 1 
	_ then описание = "Добраться до места назначения удалось только затемно. Таксист наотрез отказался ждать твоего возвращения и, нервно пробормотав что-то про нечистую силу и неупокоенные души, дал по газам. Ночь мгновенно поглотила шум мотора и ты остался один на пыльной дороге перед входом на старинное кладбище. #/$     " 
	_ else описание = "Ты находишься на пыльной дороге перед входом на старинное кладбище. "
описание = описание + "Бледный свет луны освещает кованные [[ворота|ворота]] и белеющие надгробия за ними. Неподалеку на дороге расположилась автобусная остановка. "
if сторож=1 and халк=0 then proc описание_сторожа
доп_описание = ""

if сторож = 0 
	_ then выходы = "[[на кладбище|интро_появление_сторожа]], [[к остановке|остановка]]" 
	_ else выходы = "[[на кладбище|юг]], [[к остановке|остановка]]"

действия = ""
иллюстрация = "gates.jpg"

proc случай
proc шаблон
end

:описание_сторожа
if сторож_осмотрен=0 
	_ then описание = описание + "На земле возле ворот лежит бездыханное [[тело|сторож]]. "
	_ else описание = описание + "На земле возле ворот лежит бездыханное тело. Судя по [[комбинезону|комбинезон]] с надписью Mansfield Cemetery это рабочий или сторож кладбища. Он мертв: на шее зияет ужасная [[рваная рана|рана]]. " &
		_ if not Фонарик then 
			_ описание = описание + "В руках он сжимает [[фонарик|фонарик]]."
end

:ворота
доп_описание = "На каменном столбе висит кованная табличка: Mansfield Cemetery. Ворота слегка качаются на ветру, издавая зловещий скрип. "
proc шаблон
end

:сторож
сторож_осмотрен = 1
goto дорога
end

:фонарик
if фонарик_батарейки=0 then
	_ доп_описание = "Небольшой карманный фонарик. Не включается. Наверное, сели батарейки. "
_ else
	_ доп_описание = "Небольшой карманный фонарик. Светит не особенно ярко, но все же это лучше, чем ничего. "
действия = ""
if not Фонарик then	действия = "[[взять фонарик|фонарик_взять]]"
if Батарейки and Фонарик then действия = "[[вставить батарейки|фонарик_вставить_бат]]"
proc шаблон
end

:фонарик_взять
действия = ""
inv+ Фонарик
proc дорога
доп_описание = "Ты разжал холодные пальцы бедолаги и взял фонарик. "
proc шаблон
end

:фонарик_вставить_бат
доп_описание = "Ты вставил батарейки в фонарик. "
inv- Батарейки
фонарик_батарейки=1
действия = ""
proc шаблон
end

:комбинезон
доп_описание = ""
if комбинезон_осмотрен = 0 then
	_ доп_описание = "Подавив приступ тошноты, ты осмотрел комбинезон поближе. " &
	_ комбинезон_осмотрен = 1
if not Бейдж then
	_ доп_описание = доп_описание + "В одном из карманов ты нашел [[бейдж]], а на поясе комбинезона обнаружил [[чехол]] для ножа. " 
_ else
	_ доп_описание = "На поясе комбинезона висит [[чехол]] для ножа. "
действия = ""
proc шаблон
end

:чехол
доп_описание = "Чехол пуст. " 
действия = ""
proc шаблон
end

:бейдж
доп_описание = "На бейдже написано: Конрад Крюгер, Mansfield Cemetery, сторож. "
if not Бейдж then	
	_ действия = "[[взять бейдж|бейдж_взять]]"
proc шаблон
end

:бейдж_взять
доп_описание = "Ты взял бейдж. "
действия = ""
inv+ Бейдж
proc шаблон
end

:рана
доп_описание = "Шея бедолаги буквально разорвана зубами или когтями. Удивительно, что с такой раной он смог дойти досюда. Кто мог оставить такую рану? И где этот кто-то сейчас?.. От этих мыслей тебе становится не по себе. Ты нервно оглядываешься по сторонам и прислушиваешься, но вокруг царит тишина. "
действия = ""
proc шаблон
end

:интро_появление_сторожа
сторож=1
описание = "Едва ты направился к воротам, из темноты на тебя бросилась какая-то тень. Она приблизилась и в лунном свете ты увидел всклокоченного человека в рабочем комбинезоне. Не  обращая на тебя внимания, он, шатаясь, проковылял мимо и, что-то прохрипев, замертво рухнул на землю. Ты в испуге попятился обратно на дорогу. [[дальше...|дорога]]"
доп_описание = ""
выходы = ""
действия = ""
proc шаблон
end

;------------------------------------------------------------------------------
; локация - автобусная остановка

:остановка
ЛОК="остановка"
proc tick
название = "Автобусная остановка"
описание = ""
if перелез_через_ограду=1 then
	_ описание = "Ты протискиваешься между прутьями ограды и выходишь на дорогу около автобусной остановки. #/$     "
описание = описание + "На остановке пустынно. Ближайший автобус, очевидно, придет не раньше утра. Ветер шелестит в ветвях кипарисов, растущих вдоль дороги. На остановке стоит [[скамейка|скамейка_ост]], а за ней - [[мусорная корзина|мусорка]]. "
if count_остановка=1 then
	_ описание = описание + "#/$     Ты задумываешься о том, как ты будешь выбираться отсюда. Не похоже, чтобы ночью здесь часто проезжали автомобили."
доп_описание = ""
if Колье then
	_ выходы = "[[возвращаться в город|победа]], [[к кладбищу|дорога]]"
_ else
	_ выходы = "[[к кладбищу|дорога]]"
действия = ""
иллюстрация = "road.jpg"
proc случай
proc шаблон
end

:скамейка_ост
доп_описание = "Простая, но крепкая деревянная скамейка, изрядно потрепанная дождями, солнцем и ветром. На спинке ты замечаешь вырезанную ножом надпись: Берегитесь мертвецов! "
действия = ""
proc шаблон
end

:мусорка
if not Бутылка and взрывчатка_сделана=0 then
	_ доп_описание = "В мусорном баке лежат всякие [[бутылки|бутылка]], бумажки и окурки. В общем, то, что там и должно быть. " 
_ else
	_ доп_описание = "В мусорном баке лежат всякие бумажки и окурки. В общем, то, что там и должно быть. "
действия = ""
proc шаблон
end

:бутылка
содерж=""
if бутылка_азотная = 1 then
	_ if содерж="" then содерж = "азотная кислота" else содерж = содерж + ", азотная кислота"
if бутылка_серная = 1 then
	_ if содерж="" then содерж = "серная кислота" else содерж = содерж + ", серная кислота"
if бутылка_глицерин = 1 then
	_ if содерж="" then содерж = "глицерин" else содерж = содерж + ", глицерин"

if бутылка_содержимое=0 then доп_описание = "Пустая пластиковая бутылка из-под минеральной воды. "
if бутылка_содержимое=1 then доп_описание = "В бутылку налита святая вода. "
if бутылка_содержимое=2 then доп_описание = "В бутылке находится: #%содерж$. "

действия = ""
if not Бутылка then	
	_ действия = "[[взять бутылку|бутылка_взять]]"
if Бутылка and бутылка_содержимое=1 then
	_ действия = "[[выпить воду|бутылка_выпить]]"

proc шаблон
end

:бутылка_взять
доп_описание = "Ты взял бутылку."
действия = ""
inv+ Бутылка
proc шаблон
end

:бутылка_выпить
доп_описание = "Ты выпил воду из бутылки. "
if заразился=1 then
	_ доп_описание = доп_описание + "Невероятная легкость разлилась по телу. Ты чувствуешь себя гораздо лучше. " &
	_ заразился=0 &
	_ заражение=0
_ else
	_ доп_описание = доп_описание + "Освежает. "
действия = ""
бутылка_содержимое=0
proc шаблон
end

;------------------------------------------------------------------------------
; драка с халком

:халк
ЛОК="халк"
proc tick
название = "[[Кладбище, южная часть|халк]]"
описание = "Уже почти подойдя к выходу из кладбища, ты внезапно видишь идущую навстречу человеческую фигуру в сером рабочем комбинезоне. Приглядевшись, ты с ужасом узнаешь в ней кладбищенского [[сторожа|халк_осм]], чье мертвое тело еще недавно спокойно лежало на дороге. Сейчас же его труп, поднятый из мертвых неведомой силой, словно поджидает тебя, неприкаянно бродя возле ворот. "
доп_описание = ""
выходы = ""
действия = "[[убежать|халк_убежать]], [[драться|халк_драка]]"
иллюстрация = "hulk.jpg"
proc шаблон
end

:халк_осм
доп_описание = "Мертвый сторож имеет фантастически мощное телосложение: широкие плечи и спина указывают на огромную силу. Движения его очень медленны, он потерянно топчется на месте, покачиваясь из стороны в сторону. "
proc шаблон
end

:халк_убежать
описание = "Ты поспешно скрываешься в тени и отступаешь вглубь кладбища. [[дальше...|север]]"
доп_описание = ""
выходы = ""
действия = ""
proc шаблон
end

:халк_драка
название = "[[Драка|халк_драка]]"
описание = "Как ты собираешься драться? "
доп_описание = ""
выходы = ""
действия = "[[Ударить кулаком|халк_драка_1]]"
if Нож then
	_ proc сделать & действия = действия + "[[Ударить ножом|халк_драка_2]]"
if Лопата then
	_ proc сделать & действия = действия + "[[Ударить лопатой|халк_драка_3]]"
if Лом then
	_ proc сделать & действия = действия + "[[Ударить ломом|халк_драка_4]]"
proc сделать & действия = действия + "[[Ты передумал, лучше убежать|халк_убежать]]"
proc шаблон
end

:халк_драка_1
название = "Драка"
описание = "Прячась в тени памятников и деревьев, ты незамеченным подошел почти вплотную к мертвецу и изо всех сил резко ударил его кулаком в ухо. Будь перед тобой живой человек, такой удар как минимум оглушил бы его, но мертвый сторож лишь слегка покачнулся и, издав громкий рык, выбросил в твою сторону руку. Ты с трудом уклонился от смертельного удара огромного кулака, который, пролетев мимо твоей головы, вскользь задел плечо. Боль пронзила твое тело и, отвлекшись на нее, ты пропустил следующий удар, который швырнул тебя, словно тряпку, на землю. Последнее, что ты увидел - это огромный сапог мертвеца, нацеленный в твое лицо. И вдруг стало темно... "
доп_описание = ""
выходы = ""
халк=1
if Крестик and крестик_надет=1 then
	_ описание = описание + "[[дальше...|лимб_номер = 2 & goto лимб]]"
_ else
	_ описание = описание + "[[дальше...|смерть]]"
действия = ""
proc шаблон
end

:халк_драка_2
название = "Драка"
описание = "Прячась в тени памятников и деревьев, ты незамеченным подошел почти вплотную к мертвецу и изо всех сил резко ударил его ножом в шею. Нож вошел под ключицу и застрял. Ты попытался вытащить его, но в этот момент зомби выбросил вперед огромный тяжелый кулак, который подобно молоту ударил тебя в живот. Оглушенный, ты согнулся, не в силах вздохнуть, и не увидел второй удар, пришедшийся точно в висок. Ты даже не понял, что произошло... "
доп_описание = ""
выходы = ""
халк=1
if Крестик and крестик_надет=1 then
	_ описание = описание + "[[дальше...|лимб_номер = 2 & goto лимб]]"
_ else
	_ описание = описание + "[[дальше...|смерть]]"
действия = ""
proc шаблон
end

:халк_драка_3
название = "Драка"
описание = "Держа наготове лопату, ты приблизился к мертвому сторожу и, размахнувшись, изо всех сил ударил его по голове. Острый металл со звоном ударился о череп мертвеца и рассек лицо, превратив его в ужасный кровавый оскал. Однако на монстра это, казалось, не произвело особого эффекта. Схватив лопату, он с легкостью вырвал ее из твоих рук и отбросил в сторону. А следом последовал мощный удар огромного кулака в твое лицо. Твой взгляд застлала кровавая пелена и сознание покинуло тебя... "
доп_описание = ""
выходы = ""
халк=1
if Крестик and крестик_надет=1 then
	_ описание = описание + "[[дальше...|лимб_номер = 2 & goto лимб]]"
_ else
	_ описание = описание + "[[дальше...|смерть]]"
действия = ""
proc шаблон
end

:халк_драка_4
название = "Драка"
описание = "Ты не спеша приблизился к мертвецу, держа наготове лом. Бывший сторож, увидя тебя, издал нечленораздельный рев и медленно, прихрамывая, пошел вперед. Ты хладнокровно дожидался его приближения и когда монстр подошел практически вплотную, занес над головой лом и со всей силы обрушил его на зомби, который даже не сделал попытки увернуться. От удара тяжелого стального прута голова мертвеца лопнула и грузное тело мешком повалилось на траву. [[дальше...|юг]]"
доп_описание = ""
выходы = ""
халк=2
действия = ""
proc шаблон
end

;------------------------------------------------------------------------------
; локация - юг кладбища

:юг
ЛОК="юг"
proc tick
название = "Кладбище, южная часть"
описание=""
if умер_флаг=1 then
	_ умер_флаг=0 &
	_ описание = "Ты приходишь в себя, лежа на холодной могильной плите. Тебя мутит, разбитая голова нещадно болит и кружится, во рту странный металлический привкус. Ты с трудом вспоминаешь, что произошло... #/$     "
if count_юг=1 then
	_ описание = "Ты настороженно входишь в ворота, прислушиваясь и поминутно оглядываясь. "
_ else
	_ описание = описание + "Ты находишься на южной окраине кладбища неподалеку от входных ворот. "
описание = описание + "Поросшая травой дорожка ведет на север, петляя среди покосившихся [[надгробий|могилы_юг]] и чернеющих крестов. Ветхие вязы и ясени, растущие среди могил, словно ожившие мертвецы тянут ветви в разные стороны, роняя на землю кривые тени. Немного в стороне виднеется небольшая кирпичная [[сторожка|сторожка_осм]]. "
if count_юг=1 then
	_ описание = описание + "#/$     От мрачной атмосферы этого места тебя бьет легкая дрожь. Ты бы с удовольствием оказался сейчас за тысячу миль отсюда, но те обстоятельства, в которых ты оказался по вине своей лудомании, вынуждают идти вперед. "
if халк=2 then
	_ описание = описание + "На дорожке среди могил лежит тело [[сторожа|халк_труп]], убитого этой ночью дважды. "
доп_описание = ""
if Колье and халк=0 then
	_ выходы = "[[на север|север]], [[к сторожке|усторожки]], [[на дорогу|халк]]"
_ else
	_ выходы = "[[на север|север]], [[к сторожке|усторожки]], [[на дорогу|дорога]]"
действия = ""
иллюстрация = "south.jpg"
proc случай
proc шаблон
end

:халк_труп
доп_описание = "Тело сторожа облачено в уже знакомый тебе кладбищенский комбинезон. Его голова разбита ударом лома. "
действия = ""
proc шаблон
end

:могилы_юг
доп_описание = ""
if надгробия_юг=0 then
	_ доп_описание = "Старые надгробия скрываются в тени таких же старых деревьев. Если прислушаться, можно услышать тихий таинственный шепот - то ли мертвецы из-под земли зовут живых, то ли просто ветер шумит в ветвях над головой. "

if надгробия_юг=1 then 
	_ доп_описание = доп_описание + "Ты читаешь эпитафии на черных камнях: ~ Уильям Ханн. Я же говорил, что болен! ~ "
if надгробия_юг=2 then доп_описание = доп_описание + "Ты читаешь эпитафии на черных камнях: ~ Мерфи Дренер. А тут не так уж плохо, когда привыкнешь. ~ "
if надгробия_юг=3 then доп_описание = доп_описание + "Ты читаешь эпитафии на черных камнях: ~ О.Х.Семен. Ripos in peace. ~ "

действия = ""
if надгробия_юг=0 then
	_ proc сделать & действия = действия + "[[читать эпитафии|могилы_юг_осм]]"
_ else
	_ proc сделать & действия = действия + "[[перейти к другой могиле|могилы_юг_др]]" &
	_ if Лопата then
		_ proc сделать & действия = действия + "[[раскопать эту могилу|могилы_юг_копать]]"

proc шаблон
end

:могилы_юг_др
надгробия_юг = надгробия_юг + 1
if надгробия_юг > 3 then надгробия_юг = 1
proc могилы_юг
end

:могилы_юг_осм
надгробия_юг=1
goto могилы_юг
end

:могилы_юг_копать
if надгробия_юг=1 then
	_ доп_описание = "У тебя не хватит ни времени, ни сил, чтобы раскопать все могилы на этом кладбище. Да и какой в этом смысл?. "
if надгробия_юг=2 then
	_ доп_описание = "Нет никаких причин, чтобы раскапывать эту могилу. "
if надгробия_юг=3 then
	_ доп_описание = "Вряд ли ты найдешь в этой могиле что-то хорошее, если раскопаешь ее. "
действия = ""
proc шаблон
end

:сторожка_осм
доп_описание = "Здание, окруженное рядами могил, выглядит одиноким и покинутым. "
действия = "[[подойти к сторожке|усторожки]] "
proc шаблон
end

;------------------------------------------------------------------------------
; локация - север кладбища

:север
ЛОК="север"
proc tick
название = "Кладбище, центральная часть"
описание = "Ты в центральной части кладбища, продолжающегося на запад и восток. Луна освещает множество надгробий, [[памятников|могилы_север]] и крестов, между которыми временами мелькают какие-то призрачные тени. С северной стороны виднеется кованная [[ограда|ограда_север]], местами сломанная. Через один из проломов ведет небольшая [[тропинка]]. Выход с кладбища находится на юге."
if count_север=1 then
	_ описание = описание + "#/$     Ты вспоминаешь, что склеп тетушки должен быть где-то в западной части кладбища. "
доп_описание = ""
выходы = "[[на север|берег]], [[на запад|усклепа]], [[на восток|восток]], [[на юг|юг]]"
действия = ""
иллюстрация = "north.jpg"
proc случай
proc шаблон
end

:могилы_север
свч = "крохотный огарок свечи. Похоже, кто-то пытался сделать Джиму немного светлее. "
if свеча_на_могиле=1 and свеча_горит=0 then
	_ свч = "свеча. "
if свеча_на_могиле=1 and свеча_горит=1 and блокнот_прочитан=2 and увидел_код=1 then
	_ свч = "горящая свеча. Ее свет освещает надгробие и ты надеешься, что Джиму - там, где он сейчас есть, - тоже стало немного светлее. Огонек свечи высвечивает нацарапанную на надгробии надпись: #code$" 
if свеча_на_могиле=1 and свеча_горит=1 and блокнот_прочитан=2 and увидел_код=0 then
	_ свч = "горящая свеча. Ее свет освещает надгробие и ты надеешься, что Джиму - там, где он сейчас есть, - тоже стало немного светлее... #/$     Внезапно ты замечаешь, что огонек свечи высветил надпись, выцарапанную на надгробии и не заметную в свете луны или фонаря. Всмотревшись, ты различаешь цифры: #code$" &
	_ увидел_код=1
if свеча_на_могиле=1 and свеча_горит=1 and блокнот_прочитан < 2 then
	_ свч = "горящая свеча. Ты смотришь на ее мерцающий огонек и думаешь о том, что Джиму - там, где он сейчас есть, - тоже стало немного светлее... "

доп_описание = ""
if надгробия_север=0 then
	_ доп_описание = "Памятники скрываются в высокой сухой траве, из которой раздается стрекот кузнечиков и цикад. На некоторых памятниках еще можно прочитать полустершиеся эпитафии. "

if надгробия_север=1 then 
	_ доп_описание = доп_описание + "Ты читаешь эпитафии на памятниках: ~ Боб Додсон. Наконец-то я могу спать, сколько захочу! ~ #/$     Похоже, старина Боб достиг того, о чем мечтал. Ты бы тоже хотел достигнуть своей мечты, но не таким способом, как он..."

if надгробия_север=2 then 
	_ доп_описание = доп_описание + "Ты читаешь эпитафии на памятниках: ~ Джим Райли. Черт, а здесь темно! ~ #/$     В основание этого надгробия вделан [[подсвечник]], из которого торчит #%свч$" &
	_ if блокнот_прочитан=2 and свеча_на_могиле=0 then
		_ доп_описание = доп_описание + "Хм. Похоже, это могила того самого Джима Райли, о котором написано в блокноте... " 
	
if надгробия_север=3 then 
	_ доп_описание = доп_описание + "Ты читаешь эпитафии на памятниках: ~ Фред из Бебеня. Зря я потряс эту шкатулку! ~ "

действия = ""
if надгробия_север=0 then
	_ proc сделать & действия = действия + "[[читать эпитафии|могилы_север_осм]]"
_ else
	_ proc сделать & действия = действия + "[[перейти к другой могиле|могилы_север_др]]" &
	_ if Лопата then	
		_ proc сделать & действия = действия + "[[раскопать эту могилу|могилы_север_копать]]"

proc шаблон
end

:могилы_север_др
надгробия_север = надгробия_север + 1
if надгробия_север > 3 then надгробия_север = 1
proc могилы_север
end

:могилы_север_осм
надгробия_север = 1
goto могилы_север
end

:могилы_север_копать
if надгробия_север=1 then
	_ доп_описание = "Не стоит беспокоить Боба, пусть наслаждается отдыхом. "
if надгробия_север=2 then
	_ доп_описание = "Можно потратить всю ночь, раскапывая старые могилы, но какой в этом смысл? "
if надгробия_север=3 then
	_ доп_описание = "Ты не видишь причин, чтобы раскапывать эту старую могилу."
действия = ""
proc шаблон
end

:подсвечник
if свеча_на_могиле=0 then
	_ доп_описание = "Из подсвечника торчит крохотный огарок, практически полностью сгоревший."
if свеча_на_могиле=1 and свеча_горит=0 then
	_ доп_описание = "В подсвечник вставлена большая свеча из желтого воска. "
if свеча_на_могиле=1 and свеча_горит=1 then
	_ доп_описание = "В подсвечник вставлена горящая свеча. "
действия = ""
if свеча_на_могиле=0 and Зажигалка then
	_ proc сделать & действия = действия + "[[зажечь огарок|огарок_зажечь]]"
if свеча_на_могиле=0 and Свеча then
	_ proc сделать & действия = действия + "[[поставить свечу|свеча_поставить]]"
if свеча_на_могиле=1 and свеча_горит=0 and Зажигалка then
	_ proc сделать & действия = действия + "[[зажечь свечу|свеча_зажечь]]"
proc шаблон
end

