proc tick
название = "[[Лесная тропа|утопленник]]"
описание = "Идя по лесной тропе, ты замечаешь за деревьями быстро приближающийся человеческий силуэт и в следующую минуту перед тобой оказывается [[живой мертвец|утопленник_осм]]. Его распухшее тело покрыто скользким налетом из водорослей и болотной тины, со спутанных волос ручьями стекает вода. Он протягивает чернеющие руки, готовясь вцепиться в твою шею. "
